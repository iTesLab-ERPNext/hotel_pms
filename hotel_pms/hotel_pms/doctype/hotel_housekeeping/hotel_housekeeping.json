{
  "name": "Hotel Housekeeping",
  "module": "Hotel PMS",
  "doctype": "DocType",
  "autoname": "format:HK-{YYYY}-{#####}",
  "fields": [
    {"fieldname": "room", "fieldtype": "Link", "options": "Hotel Room", "label": "Room", "reqd": 1, "in_list_view": 1},
    {"fieldname": "task_date", "fieldtype": "Date", "label": "Task Date", "reqd": 1, "in_list_view": 1},
    {"fieldname": "task_type", "fieldtype": "Select", "options": "Daily Cleaning\nDeep Clean\nTurndown\nInspection\nMaintenance Check", "label": "Task Type", "in_list_view": 1},
    {"fieldname": "status", "fieldtype": "Select", "options": "Pending\nIn Progress\nCompleted\nSkipped", "label": "Status", "default": "Pending", "in_list_view": 1},
    {"fieldname": "assigned_to", "fieldtype": "Link", "options": "User", "label": "Assigned To"},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "permissions": [
    {"role": "Hotel Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Hotel Manager", "read": 1, "write": 1},
    {"role": "Housekeeping", "read": 1, "write": 1, "create": 1}
  ]
}
