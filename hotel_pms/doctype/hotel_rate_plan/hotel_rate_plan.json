{
 "autoname": "field:plan_name",
 "creation": "2026-01-01 00:00:00.000000",
 "doctype": "DocType",
 "engine": "InnoDB",
 "fields": [
  {"fieldname": "plan_name",        "fieldtype": "Data",     "label": "Plan Name",       "reqd": 1},
  {"fieldname": "plan_code",        "fieldtype": "Data",     "label": "Code"},
  {"fieldname": "active",           "fieldtype": "Check",    "label": "Active",          "default": "1"},
  {"fieldname": "meal_plan",        "fieldtype": "Select",   "label": "Meal Plan",
   "options": "Room Only\nBed & Breakfast\nHalf Board\nFull Board\nAll Inclusive"},
  {"fieldname": "column_break_1",   "fieldtype": "Column Break"},
  {"fieldname": "rate_type",        "fieldtype": "Select",   "label": "Rate Type",
   "options": "Fixed\nPercentage Discount\nPercentage Markup"},
  {"fieldname": "rate_value",       "fieldtype": "Float",    "label": "Rate / Discount %"},
  {"fieldname": "currency",         "fieldtype": "Link",     "label": "Currency",        "options": "Currency"},
  {"fieldname": "section_validity", "fieldtype": "Section Break","label": "Validity"},
  {"fieldname": "valid_from",       "fieldtype": "Date",     "label": "Valid From"},
  {"fieldname": "valid_to",         "fieldtype": "Date",     "label": "Valid To"},
  {"fieldname": "min_nights",       "fieldtype": "Int",      "label": "Minimum Nights",  "default": "1"},
  {"fieldname": "column_break_2",   "fieldtype": "Column Break"},
  {"fieldname": "applicable_days",  "fieldtype": "Data",     "label": "Applicable Days (e.g. Mon-Fri)"},
  {"fieldname": "booking_window",   "fieldtype": "Int",      "label": "Advance Booking Window (days)"},
  {"fieldname": "description",      "fieldtype": "Small Text","label": "Description"}
 ],
 "module": "Hotel PMS",
 "name": "Hotel Rate Plan",
 "owner": "Administrator",
 "permissions": [
  {"role": "Hotel Administrator","read":1,"write":1,"create":1,"delete":1},
  {"role": "Hotel Manager",      "read":1,"write":1,"create":1},
  {"role": "Front Desk",         "read":1}
 ]
}
